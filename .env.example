# Copy to .env (git-ignored) or export in your shell. All are optional.
HF_TOKEN=            # Hugging Face access token; without it the agents use deterministic fallbacks
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=        # blank = Hugging Face router; http://localhost:11434/v1 for Ollama (HF_MODEL=qwen2.5:7b)
LLM_TIMEOUT=90       # raise to ~900 for a local model on a CPU
CROSSREF_MAILTO=     # your email, for Crossref's polite pool
MAX_CYCLES=3
